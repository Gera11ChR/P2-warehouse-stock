  "info": {
    "title": "DMS - TELECOM Inventory API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/reportes/actividades": {
      "get": {
        "description": "Reporte de actividades confirmadas: `formato=json` devuelve el\nlistado para la UI (200, más reciente primero); `formato=xlsx`\ndescarga el libro de una hoja por folio sobre la plantilla\ncorporativa, con tope de 100 folios (REQ-REP-009).\n\nCódigos del contrato (REQ-REP-011): 200 con resultados; 400\nNUMERIC_OUT_OF_RANGE (identificador positivo fuera de INT4); 403 actor\nsin acceso a la Unidad indicada; 404 sin actividades para los filtros\no Unidad ajena al actor (indistinguible de inexistente); 422\nparámetros inválidos o no declarados, `RANGO_FECHAS_INVALIDO`,\n`LIMITE_HOJAS_EXCEDIDO` (más de 100 folios) o `LIMITE_FILAS_EXCEDIDO`\n(más de 10 000 filas inyectadas).",
        "operationId": "reporte_actividades_api_v1_reportes_actividades_get",
        "parameters": [
          {
            "in": "query",
            "name": "equipo_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "exclusiveMinimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Equipo Id"
            }
          },
          {
            "in": "query",
            "name": "desde",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Desde"
            }
          },
          {
            "in": "query",
            "name": "hasta",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Hasta"
            }
          },
          {
            "in": "query",
            "name": "actividad_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "exclusiveMinimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Actividad Id"
            }
          },
          {
            "in": "query",
            "name": "formato",
            "required": false,
            "schema": {
              "default": "json",
              "enum": [
                "json",
                "xlsx"
              ],
              "title": "Formato",
              "type": "string"
            }
          },
          {
            "description": "Identificador del actor (NO autenticado; la autenticación real está fuera de alcance). 1..100 caracteres, sin caracteres de control.",
            "in": "header",
            "name": "X-Actor",
            "required": true,
            "schema": {
              "description": "Identificador del actor (NO autenticado; la autenticación real está fuera de alcance). 1..100 caracteres, sin caracteres de control.",
              "maxLength": 100,
              "minLength": 1,
              "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]*[^\\s\\x00-\\x1f\\x7f-\\x9f][^\\x00-\\x1f\\x7f-\\x9f]*$",
              "title": "X-Actor",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActividadListOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "description": "Identificador numérico fuera de rango INT4 (NUMERIC_OUT_OF_RANGE)"
          },
          "403": {
            "description": "Actor sin acceso a la Unidad (no integrante ni administrador)"
          },
          "404": {
            "description": "Sin actividades para los filtros indicados; la Unidad ajena al actor se comporta como inexistente"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Reporte Actividades",
        "tags": [
          "reportes"
        ]
      }
    }
  }
}
