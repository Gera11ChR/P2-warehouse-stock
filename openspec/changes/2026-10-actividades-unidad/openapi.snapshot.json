            "anyOf": [
              {
                "$ref": "#/components/schemas/ActividadPendienteSeguimiento"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "seguimiento"
        ],
        "title": "ActividadPendienteOut",
        "type": "object"
      },
      "ActividadPendienteSeguimiento": {
        "additionalProperties": false,
        "description": "Seguimiento CERRADA más reciente sin actividad (fn_actividad_pendiente):\nsus materiales y el valor unitario VIGENTE al momento de la consulta.",
        "properties": {
          "fecha_cierre": {
            "format": "date-time",
            "title": "Fecha Cierre",
