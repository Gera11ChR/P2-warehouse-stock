{
  "components": {
    "schemas": {
      "ActividadCreate": {
        "additionalProperties": false,
        "description": "Confirmación de actividad. El frontend descarta las celdas vacías; el\nbackend además las rechaza (defensa en profundidad, RF-6).",
        "properties": {
          "actividades": {
            "items": {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 30,
            "minItems": 1,
            "title": "Actividades",
            "type": "array"
          },
          "clientes": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Clientes",
            "type": "string"
          },
          "comentarios": {
            "anyOf": [
              {
                "maxLength": 2000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Comentarios"
          },
          "direcciones": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Direcciones",
            "type": "string"
          },
          "seguimiento_id": {
            "exclusiveMinimum": 0.0,
            "maximum": 2147483647.0,
            "title": "Seguimiento Id",
            "type": "integer"
          },
          "vehiculo": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Vehiculo",
            "type": "string"
          }
        },
        "required": [
          "seguimiento_id",
          "vehiculo",
          "clientes",
          "direcciones",
          "actividades"
        ],
        "title": "ActividadCreate",
        "type": "object"
      },
      "ActividadListOut": {
        "description": "GET por Unidad: más reciente primero (RF-16).",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ActividadOut"
            },
            "title": "Items",
            "type": "array"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total"
        ],
        "title": "ActividadListOut",
        "type": "object"
      },
      "ActividadMaterialOut": {
        "additionalProperties": false,
        "description": "Material consumido dentro del snapshot (jsonb): valores como números\nJSON. Solo lectura.",
        "properties": {
          "cantidad_consumida": {
            "title": "Cantidad Consumida",
            "type": "number"
          },
          "codigo": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Codigo"
          },
          "descripcion": {
            "title": "Descripcion",
            "type": "string"
          },
          "material_id": {
            "title": "Material Id",
            "type": "integer"
          },
          "u_m": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "U M"
          },
          "valor_unitario": {
            "title": "Valor Unitario",
            "type": "number"
          }
        },
        "required": [
          "material_id",
          "codigo",
          "descripcion",
          "u_m",
          "cantidad_consumida",
          "valor_unitario"
        ],
        "title": "ActividadMaterialOut",
        "type": "object"
      },
      "ActividadOut": {
        "additionalProperties": false,
        "description": "Eco de lectura de una actividad confirmada. `folio` es presentación\npura (`R` + folio_num con 4 dígitos mínimo), nunca entrada del cliente.",
        "properties": {
          "actividad_id": {
            "title": "Actividad Id",
            "type": "integer"
          },
          "actividades": {
            "items": {
              "type": "string"
            },
            "title": "Actividades",
            "type": "array"
          },
          "clientes": {
            "title": "Clientes",
            "type": "string"
          },
          "comentarios": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Comentarios"
          },
          "direcciones": {
            "title": "Direcciones",
            "type": "string"
          },
          "equipo_id": {
            "title": "Equipo Id",
            "type": "integer"
          },
          "equipo_nombre": {
            "title": "Equipo Nombre",
            "type": "string"
          },
          "fecha": {
            "format": "date-time",
