  "info": {
    "paquete": "2026-10-actividades-unidad",
    "title": "DMS - TELECOM Inventory API"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/equipos/{equipo_id}/actividades": {
      "get": {
        "description": "Historial de actividades confirmadas de la Unidad, más reciente\nprimero (RF-16).",
        "operationId": "listar_actividades_api_v1_equipos__equipo_id__actividades_get",
        "parameters": [
          {
            "in": "path",
            "name": "equipo_id",
            "required": true,
            "schema": {
              "title": "Equipo Id",
              "type": "integer"
            }
          },
          {
            "description": "Identificador del actor (NO autenticado; la autenticación real está fuera de alcance). 1..100 caracteres, sin caracteres de control.",
            "in": "header",
            "name": "X-Actor",
            "required": true,
            "schema": {
              "description": "Identificador del actor (NO autenticado; la autenticación real está fuera de alcance). 1..100 caracteres, sin caracteres de control.",
              "maxLength": 100,
              "minLength": 1,
              "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]*[^\\s\\x00-\\x1f\\x7f-\\x9f][^\\x00-\\x1f\\x7f-\\x9f]*$",
              "title": "X-Actor",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActividadListOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "description": "Identificador numérico fuera de rango INT4 (NUMERIC_OUT_OF_RANGE)"
          },
          "403": {
            "description": "Actor sin acceso a la Unidad (no integrante ni administrador)"
          },
          "404": {
            "description": "Unidad no encontrada o inactiva"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Listar Actividades",
        "tags": [
          "actividades"
        ]
      },
      "post": {
        "description": "Confirmación delegada a fn_crear_actividad: folio global correlativo,\nfecha now(), snapshot de materiales, unicidad 1:1 con el seguimiento\nCERRADA y evento ACTIVIDAD_CONFIRMADA íntegros en PostgreSQL. El folio\ndevuelto es el asignado por la base (nunca aceptado del cliente).",
        "operationId": "crear_actividad_api_v1_equipos__equipo_id__actividades_post",
        "parameters": [
          {
            "in": "path",
            "name": "equipo_id",
            "required": true,
            "schema": {
              "title": "Equipo Id",
              "type": "integer"
            }
          },
          {
            "description": "Identificador del actor (NO autenticado; la autenticación real está fuera de alcance). 1..100 caracteres, sin caracteres de control.",
            "in": "header",
            "name": "X-Actor",
            "required": true,
            "schema": {
              "description": "Identificador del actor (NO autenticado; la autenticación real está fuera de alcance). 1..100 caracteres, sin caracteres de control.",
              "maxLength": 100,
              "minLength": 1,
              "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]*[^\\s\\x00-\\x1f\\x7f-\\x9f][^\\x00-\\x1f\\x7f-\\x9f]*$",
              "title": "X-Actor",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ActividadCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActividadOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "description": "Identificador numérico fuera de rango INT4 (NUMERIC_OUT_OF_RANGE)"
          },
          "403": {
            "description": "Actor sin acceso a la Unidad (no integrante ni administrador)"
          },
          "404": {
            "description": "Unidad no encontrada (o seguimiento inexistente para la Unidad: SEGUIMIENTO_NO_ENCONTRADO)"
          },
          "409": {
            "description": "Seguimiento no cerrado (SEGUIMIENTO_NO_CERRADO) o con actividad ya confirmada (ACTIVIDAD_DUPLICADA)"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Crear Actividad",
        "tags": [
          "actividades"
        ]
      }
    },
    "/api/v1/equipos/{equipo_id}/actividades/pendiente": {
      "get": {
        "description": "Seguimiento CERRADA más reciente de la Unidad sin actividad, con sus\nmateriales consumidos y el valor unitario vigente (RF-2). `seguimiento:\nnull` si no hay (RF-3).",
        "operationId": "actividad_pendiente_api_v1_equipos__equipo_id__actividades_pendiente_get",
        "parameters": [
          {
            "in": "path",
            "name": "equipo_id",
            "required": true,
            "schema": {
              "title": "Equipo Id",
              "type": "integer"
            }
          },
          {
            "description": "Identificador del actor (NO autenticado; la autenticación real está fuera de alcance). 1..100 caracteres, sin caracteres de control.",
            "in": "header",
            "name": "X-Actor",
            "required": true,
            "schema": {
              "description": "Identificador del actor (NO autenticado; la autenticación real está fuera de alcance). 1..100 caracteres, sin caracteres de control.",
              "maxLength": 100,
              "minLength": 1,
              "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]*[^\\s\\x00-\\x1f\\x7f-\\x9f][^\\x00-\\x1f\\x7f-\\x9f]*$",
              "title": "X-Actor",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActividadPendienteOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "description": "Identificador numérico fuera de rango INT4 (NUMERIC_OUT_OF_RANGE)"
          },
          "403": {
            "description": "Actor sin acceso a la Unidad (no integrante ni administrador)"
          },
          "404": {
            "description": "Unidad no encontrada o inactiva"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Actividad Pendiente",
        "tags": [
          "actividades"
        ]
      }
    }
  }
}
