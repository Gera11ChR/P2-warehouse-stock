{
  "openapi": "3.1.0",
  "info": {
    "title": "DMS - TELECOM Inventory API — Referencia de materiales por Unidad (BORRADOR)",
    "version": "0.1.0-draft",
    "description": "Borrador de contrato del paquete 2026-10-referencia-materiales-unidades. NO congelado: T7 lo regenera desde app.openapi() y marca frozen: true."
  },
  "paths": {
    "/api/v1/equipos/{equipo_id}/referencia": {
      "get": {
        "summary": "Listar la Referencia de materiales de la Unidad",
        "description": "Líneas de la Unidad ordenadas por descripción ascendente y material_id ascendente; descripción, código y U.M. se leen del catálogo en cada consulta; los materiales inactivos del catálogo no se listan. Solo lectura, sin eventos de auditoría.",
        "operationId": "listarReferencia",
        "parameters": [
          {
            "name": "equipo_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "title": "Equipo Id"
            }
          },
          {
            "name": "X-Actor",
            "in": "header",
            "required": true,
            "description": "Identificador del actor (NO autenticado; la autenticación real está fuera de alcance). 1..100 caracteres, sin caracteres de control.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "title": "X-Actor",
              "description": "Identificador del actor (NO autenticado; la autenticación real está fuera de alcance). 1..100 caracteres, sin caracteres de control."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReferenciaListOut"
                }
              }
            }
          },
          "400": {
            "description": "Identificador numérico fuera de rango INT4 (NUMERIC_OUT_OF_RANGE)"
          },
          "403": {
            "description": "Actor sin acceso a la Unidad (no integrante ni administrador)"
          },
          "404": {
            "description": "Unidad no encontrada (404 antes de 403); en escrituras, Unidad inactiva"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Agregar líneas a la Referencia de la Unidad (todo o nada)",
        "description": "1 a 50 líneas en una sola transacción. Errores de negocio con cuerpo {\"error\":{\"code\",\"message\",\"coordinates\"}}: 404 MATERIAL_NO_ENCONTRADO, 409 REFERENCIA_DUPLICADA, 422 REFERENCIA_LINEA_DUPLICADA. La escritura exige Unidad activa.",
        "operationId": "crearReferencia",
        "parameters": [
          {
            "name": "equipo_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "title": "Equipo Id"
            }
          },
          {
            "name": "X-Actor",
            "in": "header",
            "required": true,
            "description": "Identificador del actor (NO autenticado; la autenticación real está fuera de alcance). 1..100 caracteres, sin caracteres de control.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "title": "X-Actor",
              "description": "Identificador del actor (NO autenticado; la autenticación real está fuera de alcance). 1..100 caracteres, sin caracteres de control."
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReferenciaCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReferenciaListOut"
                }
              }
            }
          },
          "400": {
            "description": "Identificador numérico fuera de rango INT4 (NUMERIC_OUT_OF_RANGE)"
          },
          "403": {
            "description": "Actor sin acceso a la Unidad (no integrante ni administrador)"
          },
          "404": {
            "description": "Unidad no encontrada (404 antes de 403); en escrituras, Unidad inactiva"
          },
          "409": {
            "description": "Material ya presente en la Referencia de la Unidad (REFERENCIA_DUPLICADA), incluye la carrera concurrente"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/equipos/{equipo_id}/referencia/{material_id}": {
      "patch": {
        "summary": "Modificar la cantidad semanal de una línea de la Referencia",
        "description": "Solo cambia cantidad_semanal. 404 REFERENCIA_NO_ENCONTRADA si la línea no existe. La escritura exige Unidad activa.",
        "operationId": "modificarReferencia",
        "parameters": [
          {
            "name": "equipo_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "title": "Equipo Id"
            }
          },
          {
            "name": "material_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "title": "Material Id"
            }
          },
          {
            "name": "X-Actor",
            "in": "header",
            "required": true,
            "description": "Identificador del actor (NO autenticado; la autenticación real está fuera de alcance). 1..100 caracteres, sin caracteres de control.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "title": "X-Actor",
              "description": "Identificador del actor (NO autenticado; la autenticación real está fuera de alcance). 1..100 caracteres, sin caracteres de control."
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReferenciaUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReferenciaLineaOut"
                }
              }
            }
          },
          "400": {
            "description": "Identificador numérico fuera de rango INT4 (NUMERIC_OUT_OF_RANGE)"
          },
          "403": {
            "description": "Actor sin acceso a la Unidad (no integrante ni administrador)"
          },
          "404": {
            "description": "Unidad no encontrada (404 antes de 403); en escrituras, Unidad inactiva"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Eliminar una línea de la Referencia",
        "description": "Borra la línea; el trigger de auditoría conserva los valores previos. 404 REFERENCIA_NO_ENCONTRADA si no existe. La escritura exige Unidad activa.",
        "operationId": "eliminarReferencia",
        "parameters": [
          {
            "name": "equipo_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "title": "Equipo Id"
            }
          },
          {
            "name": "material_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "title": "Material Id"
            }
          },
          {
            "name": "X-Actor",
            "in": "header",
            "required": true,
            "description": "Identificador del actor (NO autenticado; la autenticación real está fuera de alcance). 1..100 caracteres, sin caracteres de control.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "title": "X-Actor",
              "description": "Identificador del actor (NO autenticado; la autenticación real está fuera de alcance). 1..100 caracteres, sin caracteres de control."
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "400": {
            "description": "Identificador numérico fuera de rango INT4 (NUMERIC_OUT_OF_RANGE)"
          },
          "403": {
            "description": "Actor sin acceso a la Unidad (no integrante ni administrador)"
          },
          "404": {
            "description": "Unidad no encontrada (404 antes de 403); en escrituras, Unidad inactiva"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ReferenciaLineaCreate": {
        "type": "object",
        "title": "ReferenciaLineaCreate",
        "additionalProperties": false,
        "required": [
          "material_id",
          "cantidad_semanal"
        ],
        "properties": {
          "material_id": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "title": "Material Id"
          },
          "cantidad_semanal": {
            "type": "number",
            "exclusiveMinimum": 0,
            "title": "Cantidad Semanal",
            "description": "> 0, hasta 12 dígitos y 3 decimales"
          }
        }
      },
      "ReferenciaCreate": {
        "type": "object",
        "title": "ReferenciaCreate",
        "additionalProperties": false,
        "required": [
          "lineas"
        ],
        "properties": {
          "lineas": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "$ref": "#/components/schemas/ReferenciaLineaCreate"
            },
            "title": "Lineas"
          }
        }
      },
      "ReferenciaUpdate": {
        "type": "object",
        "title": "ReferenciaUpdate",
        "additionalProperties": false,
        "required": [
          "cantidad_semanal"
        ],
        "properties": {
          "cantidad_semanal": {
            "type": "number",
            "exclusiveMinimum": 0,
            "title": "Cantidad Semanal",
            "description": "> 0, hasta 12 dígitos y 3 decimales"
          }
        }
      },
      "ReferenciaLineaOut": {
        "type": "object",
        "title": "ReferenciaLineaOut",
        "required": [
          "material_id",
          "codigo",
          "descripcion",
          "u_m",
          "cantidad_semanal"
        ],
        "properties": {
          "material_id": {
            "type": "integer",
            "title": "Material Id"
          },
          "codigo": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Codigo"
          },
          "descripcion": {
            "type": "string",
            "title": "Descripcion"
          },
          "u_m": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "U M"
          },
          "cantidad_semanal": {
            "type": "number",
            "title": "Cantidad Semanal"
          }
        }
      },
      "ReferenciaListOut": {
        "type": "object",
        "title": "ReferenciaListOut",
        "required": [
          "items",
          "total"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReferenciaLineaOut"
            },
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          }
        }
      },
      "HTTPValidationError": {
        "type": "object",
        "title": "HTTPValidationError",
        "properties": {
          "detail": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail"
          }
        }
      },
      "ValidationError": {
        "type": "object",
        "title": "ValidationError",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "properties": {
          "loc": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        }
      }
    }
  }
}
